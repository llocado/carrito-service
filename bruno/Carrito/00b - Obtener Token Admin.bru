meta {
  name: 00b - Obtener Token Admin
  type: http
  seq: 2
}

post {
  url: {{keycloakUrl}}/realms/supermercado/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  client_id: supermercado-web
  grant_type: password
  username: admin1
  password: admin1
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setVar("tokenAdmin", res.body.access_token);
  }
}

docs {
  Pide un access token a Keycloak con el usuario de prueba admin1 (rol "admin") y lo guarda en `tokenAdmin`. Lo usan las
  requests que crean, cargan stock y borran el producto de prueba en productos-service: escribir en el catalogo exige
  rol admin (leerlo es publico). Requiere supermercado-infra corriendo.
}
