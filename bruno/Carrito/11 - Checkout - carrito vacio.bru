meta {
  name: 11 - Checkout - carrito vacio
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/carrito/checkout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 409
}

docs {
  Con el carrito vacio no hay nada que comprar: responde 409 y no publica
  ningun evento. Correr despues de "07 - Vaciar Carrito" (que deja el
  carrito vacio).
}
