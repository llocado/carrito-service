meta {
  name: 07 - Vaciar Carrito
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/api/carrito
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 204
}

docs {
  Vacia todos los items del carrito de una vez. En el diseno final (ver
  ROADMAP.md de app-productos) esto lo dispara automaticamente un evento de
  "pago aprobado" -- por ahora es un endpoint manual para poder probarlo.
}
