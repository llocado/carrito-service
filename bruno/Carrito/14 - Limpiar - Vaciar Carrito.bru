meta {
  name: 14 - Limpiar - Vaciar Carrito
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/api/carrito
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 204
}

docs {
  Limpieza: el checkout ("13") deja el carrito con items (no se vacia hasta
  que el pago se apruebe). Este request lo vacia para que la coleccion se
  pueda repetir sin acumular datos.
}
