meta {
  name: 01 - Crear Producto de Prueba
  type: http
  seq: 2
}

post {
  url: {{productosServiceUrl}}/api/productos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sku": "{{skuUnico}}",
    "nombre": "Pan Baguette",
    "descripcion": "Producto de prueba para probar el carrito",
    "precioMonto": 1200,
    "moneda": "CLP",
    "categoriaId": "b6f3c1e0-2a3b-4c5d-8e9f-0a1b2c3d4e5f"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  // SKU nuevo en cada ejecucion (3-20 caracteres: "CD-" + 13 digitos): repetir la coleccion no
  // choca con el producto de ejecuciones anteriores (409 por SKU duplicado).
  bru.setVar("skuUnico", "CD-" + Date.now());
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("productoId", res.body.id);
  }
}

docs {
  Crea un producto en productos-service (con un SKU distinto en cada
  ejecucion; el ultimo request de la coleccion lo elimina) (debe estar corriendo en
  localhost:8080) y guarda su id en la variable `productoId`, que usan las
  siguientes requests de este carrito. Nace con stock 0: "01b - Ingresar Stock de Prueba" le carga unidades.
}
